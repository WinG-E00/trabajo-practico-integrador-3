      ]
    },
    {
      "name": "Limpieza (ejecutar al final)",
      "description": "Solicitudes destructivas. Si ejecutás la colección completa, este grupo corre después de los CRUD.",
      "item": [
        {
          "name": "Cerrar sesión",
          "request": {
            "method": "POST",
            "header": [
              {
                "key": "Cookie",
                "value": "token={{token}}"
              }
            ],
            "url": {
              "raw": "{{baseUrl}}/api/auth/logout",
              "host": [
                "{{baseUrl}}"
              ],
              "path": [
                "api",
                "auth",
                "logout"
              ]
            }
          }
        },
        {
          "name": "Eliminar categoría por ID (requiere admin)",
          "request": {
            "method": "DELETE",
            "header": [
              {
                "key": "Cookie",
                "value": "token={{token}}"
              }
            ],
            "url": {
              "raw": "{{baseUrl}}/api/categories/{{categoryId}}",
              "host": [
                "{{baseUrl}}"
              ],
              "path": [
                "api",
                "categories",
                "{{categoryId}}"
              ]
            },
            "description": "Operación destructiva para la categoría indicada."
          }
        },
        {
          "name": "Eliminar evento por ID",
          "request": {
            "method": "DELETE",
            "header": [
              {
                "key": "Cookie",
