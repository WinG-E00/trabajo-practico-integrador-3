              },
              {
                "key": "Cookie",
                "value": "token={{token}}"
              }
            ],
            "body": {
              "mode": "raw",
              "raw": "{\n  \"title\": \"Evento {{$timestamp}}\",\n  \"description\": \"Evento de prueba creado desde la colección Postman.\",\n  \"startDate\": \"2030-05-10T10:00:00.000Z\",\n  \"endDate\": \"2030-05-10T12:00:00.000Z\",\n  \"capacity\": 100,\n  \"price\": 0,\n  \"status\": \"scheduled\",\n  \"location\": {\n    \"venue\": \"Sala de prueba\",\n    \"address\": \"Calle de prueba 123\",\n    \"city\": \"Buenos Aires\"\n  },\n  \"categories\": [\"{{categoryId}}\"]\n}"
            },
            "url": {
              "raw": "{{baseUrl}}/api/events",
              "host": [
                "{{baseUrl}}"
              ],
              "path": [
                "api",
                "events"
              ]
            },
            "description": "Creá antes una categoría para que categoryId tenga un valor válido."
          },
          "event": [
            {
              "listen": "test",
              "script": {
                "type": "text/javascript",
                "exec": [
                  "try {",
                  "  const response = pm.response.json();",
                  "  const id = response.data && (response.data._id || response.data.id);",
                  "  if (id) pm.collectionVariables.set('eventId', id);",
                  "} catch (error) {}"
                ]
              }
            }
          ]
        },
        {
